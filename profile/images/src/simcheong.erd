        {
            "memoId": "e4758b3e-ca45-4b66-b664-d765a316c3e7",
            "memo": "schedule 스키마 · mcp-schedule\n일정·장소",
            "rectangleViewModel": {
                "positionX": 1340,
                "positionY": 20,
                "width": 560,
                "height": 90
            },
