            "memoId": "b7733a24-0d5a-4be6-bc2b-2945ab275516",
            "memo": "schedule 스키마 · mcp-schedule\n일정·장소",
            "rectangleViewModel": {
                "positionX": 1340,
                "positionY": 20,
