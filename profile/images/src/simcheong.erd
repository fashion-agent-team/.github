            "memo": "schedule 스키마 · mcp-schedule\n일정·장소",
            "rectangleViewModel": {
                "positionX": 1340,
                "positionY": 20,
                "width": 560,
                "height": 90
            },
            "backgroundColor": {
                "red": 243,
                "green": 235,
